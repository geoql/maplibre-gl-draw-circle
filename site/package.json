{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "description": "Live demo of @geoql/maplibre-gl-draw-circle at maplibre-gl-draw-circle.geoql.in",
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt build && wrangler dev --config .output/server/wrangler.json",
    "deploy": "nuxt build && wrangler deploy --config .output/server/wrangler.json",
    "postinstall": "nuxt prepare",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "nuxt typecheck",
    "test": "vp test run"
  },
  "dependencies": {
    "@geoql/maplibre-gl-draw-circle": "workspace:*",
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "@nuxt/scripts": "^1.3.12",
    "@nuxtjs/color-mode": "^4.0.1",
    "@openpanel/nuxt": "^0.4.2",
    "@turf/circle": "^7.4.0",
    "maplibre-gl": "^6.15.0",
    "nuxt": "^4.6.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.152.0"
  }
