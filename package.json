{
  "name": "maplibre-gl-draw-circle",
  "version": "0.1.0",
  "private": false,
  "description": "A module to draw a circle on maplibre-gl map",
  "keywords": [
    "circle",
    "draw",
    "geojson",
    "maplibre",
    "maplibre-gl",
    "maplibre-gl-js"
  ],
  "homepage": "https://github.com/geoql/maplibre-gl-draw-circle#readme",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-draw-circle/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "contributors": [
    "Anvesh Kumar Arrabochu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-draw-circle.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vitest run",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish"
  },
  "dependencies": {
    "@mapbox/geojson-extent": "^1.0.1",
    "@mapbox/mapbox-gl-draw": "1.4.1",
    "@turf/along": "^6.5.0",
    "@turf/circle": "^6.5.0",
    "@turf/distance": "^6.5.0",
    "@turf/helpers": "^6.5.0",
    "@turf/length": "^6.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/geojson": "^7946.0.10",
    "@types/mapbox__mapbox-gl-draw": "^1.4.0",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.3.0",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.9",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
