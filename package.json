{
  "name": "@geoql/maplibre-gl-draw-circle",
  "version": "0.1.2",
  "private": false,
  "description": "A module to draw a circle on maplibre-gl map",
  "keywords": [
    "circle",
    "draw",
    "geojson",
    "maplibre",
    "maplibre-gl",
    "maplibre-gl-js"
  ],
  "homepage": "https://maplibre-gl-draw-circle.geoql.in",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-draw-circle/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "contributors": [
    "Anvesh Kumar Arrabochu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-draw-circle.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vitest run",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish",
    "site:dev": "pnpm --filter site dev",
    "site:build": "pnpm run build && pnpm --filter site build",
    "deploy": "pnpm run build && pnpm --filter site deploy"
  },
  "dependencies": {
    "@mapbox/geojson-extent": "^1.0.1",
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "@turf/circle": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/geojson": "^7946.0.16",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0",
    "vitest": "^5.0.5"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
